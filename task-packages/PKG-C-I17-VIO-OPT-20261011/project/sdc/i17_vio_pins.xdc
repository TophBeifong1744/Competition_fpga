# 中文用途：11 个板级 IO，展开为 XDC 原生命令，无过程控制。
create_clock -name sys_clk -period 20.000 [get_ports sys_clk]
set_property PACKAGE_PIN U18 [get_ports {sys_clk}]
set_property IOSTANDARD LVCMOS33 [get_ports {sys_clk}]
set_property PACKAGE_PIN T15 [get_ports {pwm_horizontal}]
set_property IOSTANDARD LVCMOS33 [get_ports {pwm_horizontal}]
set_property PACKAGE_PIN W16 [get_ports {pwm_vertical}]
set_property IOSTANDARD LVCMOS33 [get_ports {pwm_vertical}]
set_property PACKAGE_PIN V11 [get_ports {mic_clock[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {mic_clock[0]}]
set_property PACKAGE_PIN Y13 [get_ports {mic_clock[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {mic_clock[1]}]
set_property PACKAGE_PIN U14 [get_ports {mic_clock[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {mic_clock[2]}]
set_property PACKAGE_PIN V12 [get_ports {mic_clock[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {mic_clock[3]}]
set_property PACKAGE_PIN Y9 [get_ports {mic_data[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {mic_data[0]}]
set_property PACKAGE_PIN W10 [get_ports {mic_data[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {mic_data[1]}]
set_property PACKAGE_PIN W14 [get_ports {mic_data[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {mic_data[2]}]
set_property PACKAGE_PIN V15 [get_ports {mic_data[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {mic_data[3]}]
set_property DRIVE 4 [get_ports {pwm_horizontal pwm_vertical mic_clock[0] mic_clock[1] mic_clock[2] mic_clock[3]}]
set_property SLEW SLOW [get_ports {pwm_horizontal pwm_vertical mic_clock[0] mic_clock[1] mic_clock[2] mic_clock[3]}]
# MMCM 50 -> 96 -> 61.44 MHz 自动派生相关时钟，不设异步 clock group。
