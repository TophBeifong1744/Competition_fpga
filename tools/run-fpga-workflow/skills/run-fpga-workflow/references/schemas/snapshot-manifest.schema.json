{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "snapshot-manifest.schema.json",
  "title": "FPGA snapshot manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "snapshot_id", "revision", "dirty_diff_sha256", "target", "source_files"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string"},
    "dirty_diff_sha256": {"type": "string"},
    "target": {"type": "object"},
    "defines": {"type": "array", "items": {"type": "string"}},
    "parameters": {"type": "object"},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "source_files": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"]}}
  },
  "additionalProperties": true
}
