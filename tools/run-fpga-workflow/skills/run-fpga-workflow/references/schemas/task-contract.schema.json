{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-contract.schema.json",
  "title": "FPGA task contract",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "snapshot_id",
    "mode",
    "authorization",
    "scope",
    "non_goals",
    "immutable_boundaries",
    "acceptance_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "baseline_task_id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "ANALYZE",
        "QUICK",
        "FULL"
      ]
    },
    "evidence_profile": {
      "enum": [
        "DIAGNOSTIC_SMOKE",
        "FUNCTIONAL_ACCEPTANCE",
        "SPECIALIST_ACCEPTANCE"
      ]
    },
    "claim_stage": {
      "enum": [
        "PREFLIGHT",
        "COMPILE",
        "SIM_SMOKE",
        "FUNCTIONAL_SIM",
        "SYNTHESIS",
        "IMPLEMENTATION_QOR",
        "TIMING_CLOSURE",
        "FORMAL",
        "RELEASE",
        "BOARD_PREP",
        "BOARD_FUNCTIONAL"
      ]
    },
    "requested_claim": {
      "type": "string"
    },
    "project_identity": {
      "type": "object",
      "properties": {
        "project_root": {
          "type": "string"
        },
        "canonical_project_entry": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "part": {
          "type": "string"
        },
        "product_top": {
          "type": "string"
        },
        "simulation_top": {
          "type": "string"
        },
        "build_entry": {
          "type": "string"
        },
        "simulation_entry": {
          "type": "string"
        },
        "lint_entry": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "current_task": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "task_delta": {
      "type": "object",
      "properties": {
        "relation": {
          "enum": [
            "INITIAL",
            "SUPPLEMENTS",
            "SUPERSEDES",
            "EXPANDS",
            "NARROWS"
          ]
        },
        "adds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "oneOf": [
        {
          "enum": [
            "READ_ONLY",
            "PRODUCT_WRITE",
            "SEQUENTIAL_WRITES"
          ]
        },
        {
          "type": "object",
          "properties": {
            "write_product": {
              "type": "boolean"
            },
            "write_constraints": {
              "type": "boolean"
            },
            "write_verification": {
              "type": "boolean"
            },
            "run_formal_entrypoints": {
              "type": "boolean"
            },
            "clean_or_overwrite": {
              "type": "boolean"
            },
            "regenerate_ip": {
              "type": "boolean"
            },
            "run_implementation": {
              "type": "boolean"
            },
            "generate_release": {
              "type": "boolean"
            },
            "external_publish": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "protected_work": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "board_boundary": {
      "type": "object",
      "properties": {
        "in_scope": {
          "type": "boolean"
        },
        "offline_artifacts_only": {
          "type": "boolean"
        },
        "physical_actions_by_user": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "immutable_boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "role_routing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "reason"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "shadow": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
