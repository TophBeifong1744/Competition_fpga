{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-manifest.schema.json",
  "title": "FPGA tool run manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "snapshot_id", "job_id", "command", "working_directory", "tool", "exit_code", "evidence_paths"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string"},
    "snapshot_id": {"type": "string"},
    "job_id": {"type": "string"},
    "command": {"type": "string"},
    "working_directory": {"type": "string"},
    "tool": {"type": "object", "required": ["name", "version"]},
    "target": {"type": "string"},
    "case": {"type": "string"},
    "seed": {"type": ["integer", "string"]},
    "libraries": {"type": "array", "items": {"type": "string"}},
    "compile_exit_code": {"type": "integer"},
    "elaboration_exit_code": {"type": "integer"},
    "run_exit_code": {"type": "integer"},
    "exit_code": {"type": "integer"},
    "evidence_paths": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
